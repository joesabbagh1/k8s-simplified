{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kubelearn",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    // every page is a file written by scripts/prerender.mjs; any other path gets 404.html with a 404 status
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "kubelearn.joesabbagh.com", "custom_domain": true }]
}
